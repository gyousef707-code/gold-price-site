# Upstash Redis (تخزين اشتراكات الأجهزة) — من صفحة الـ Database بتاعتك على upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# مفاتيح VAPID (لتوقيع وتشفير Web Push) — اتولّدت مرة واحدة، منفعش تتغير بعد كده
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# نفس الـ VAPID_PUBLIC_KEY لكن كمتغير بناء (build-time) عشان المتصفح يقدر يشترك
VITE_VAPID_PUBLIC_KEY=

# كلمة سر بسيطة تحمي endpoint الفحص الدوري من إن أي حد ينادي عليه غيرك
CRON_SECRET=

# بوت تيليجرام (نفس البوت) — بيُستخدم لإرسال ملخص الأسعار للقناة العامة
# ولإرسال تنبيهات الأعطال الخاصة بيك
TELEGRAM_BOT_TOKEN=
# آيدي القناة العامة (t.me/zahaby1) اللي بيتبعتلها ملخص الأسعار كل ساعة
TELEGRAM_CHANNEL_ID=
# آيدي الشات الخاص بيك (مش القناة) — هنا بس بيوصلك تنبيه لو مصدر سعر فشل
# إزاي تجيبه: ابعت أي رسالة لبوتك من حسابك الشخصي، بعدين افتح في المتصفح
# https://api.telegram.org/bot<TOKEN>/getUpdates وهتلاقي "chat":{"id": ...}
TELEGRAM_ALERT_CHAT_ID=
